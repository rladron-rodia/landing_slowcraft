# ============================================================================
# Template Landing_Site — env.example
# ============================================================================
# Copiar a .env.local (no commitear). En production se setean en el dashboard
# de Cloudflare Pages / Vercel / Railway según corresponda.
# ============================================================================

# --- Form de contacto ---
NEXT_PUBLIC_CONTACT_ENDPOINT=https://slowcraft-api.onrender.com/api/contact

# --- Site canonicals ---
NEXT_PUBLIC_SITE_URL=https://slowcraft.ai
NEXT_PUBLIC_DEFAULT_LOCALE=es-MX

# --- Plugins de medición (todos opcionales — vacío = no carga script) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=
NEXT_PUBLIC_HOTJAR_ID=

# --- Observabilidad (Fase E, opcional) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
