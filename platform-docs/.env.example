# ============================================================================
# Producto #001 (Landing_Site) — Variables de entorno del Template
# ============================================================================
# Este archivo documenta TODAS las env vars que el Template puede consumir.
# Copia el contenido a .env.local (en template-next/) o configúralas en el
# dashboard de Cloudflare Pages / Vercel / Railway según corresponda.
#
# Convención:
#   NEXT_PUBLIC_*  → expuestas al cliente (browser). Sin secretos sensibles.
#   Otras          → server-only. Nunca commitear con valor real.
# ============================================================================

# ----------------------------------------------------------------------------
# Form de contacto — endpoint donde se postea el lead
# ----------------------------------------------------------------------------
# Required. Endpoint que recibe el lead. Debe aceptar POST con el shape del
# form (ver src/lib/contact-schema.ts).
#
# Para la instance Slowcraft: el backend Express en Render.
# Para otros forks: configurable por el cliente (puede ser Supabase, Vercel
# function, Formspree, etc.).
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.slowcraft.ai/api/contact

# ----------------------------------------------------------------------------
# Plugin: Google Analytics 4
# ----------------------------------------------------------------------------
# Optional. Si está vacío, el plugin no carga ningún script.
# Para la instance Slowcraft: G-TJEN2EXGSN
NEXT_PUBLIC_GA4_ID=

# ----------------------------------------------------------------------------
# Plugin: Google Tag Manager
# ----------------------------------------------------------------------------
# Optional. Si está set, toma prioridad sobre GA4 directo (GA4 se routea desde
# GTM). Si ambos están set, solo GTM carga.
# Para la instance Slowcraft: GTM-WM6WHTW3
NEXT_PUBLIC_GTM_ID=

# ----------------------------------------------------------------------------
# Plugin: Meta Pixel (Facebook)
# ----------------------------------------------------------------------------
# Optional. ID numérico del píxel.
NEXT_PUBLIC_META_PIXEL_ID=

# ----------------------------------------------------------------------------
# Plugin: Google Search Console verification
# ----------------------------------------------------------------------------
# Optional. Verification meta tag content (sin el prefijo "google-site-verification=").
# Solo agrega un <meta>, no carga scripts.
NEXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# ----------------------------------------------------------------------------
# Plugin: Hotjar
# ----------------------------------------------------------------------------
# Optional. Site ID numérico.
NEXT_PUBLIC_HOTJAR_ID=

# ----------------------------------------------------------------------------
# Site config
# ----------------------------------------------------------------------------
# Required. URL canónica del sitio (sin trailing slash). Usada en meta tags,
# OG, sitemap, etc.
NEXT_PUBLIC_SITE_URL=https://slowcraft.ai

# Optional. Locale por default si el navegador no manda Accept-Language.
NEXT_PUBLIC_DEFAULT_LOCALE=es-MX

# ----------------------------------------------------------------------------
# Observabilidad (Fase E — opcional)
# ----------------------------------------------------------------------------
# Optional. Sentry DSN. Si vacío, Sentry no se inicializa.
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Posthog public key + host. Si vacíos, Posthog no se inicializa.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ----------------------------------------------------------------------------
# Server-only — solo si el Template incluye API routes propias (futuro)
# ----------------------------------------------------------------------------
# Estas NO se exponen al browser. Documentadas aquí por completitud — hoy el
# Template no las usa porque el form delega al backend Express externo.

# Resend API key (para React Email templates server-side, post-Fase E)
RESEND_API_KEY=

# JWT secret (si el Template incluye auth en algún momento — actualmente no)
# JWT_SECRET=

# ============================================================================
# Variables del backend Express (legacy — viven en backend/.env, no aquí)
# ============================================================================
# DATABASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD_HASH, etc. → ver backend/.env.example
# ============================================================================
