# ===== Slowcraft API · variables de entorno =====
# Copia este archivo a .env (NO se commitea) y rellená.
# En Render estas se configuran en el dashboard como secrets.

# --- Database ---
# Render inyecta DATABASE_URL automáticamente cuando vinculás la DB al servicio.
# Para desarrollo local: postgres://user:pass@localhost:5432/slowcraft
DATABASE_URL=

# --- CORS ---
# URLs separadas por coma. Mínimo: el origen del front en GitHub Pages.
ALLOWED_ORIGINS=https://rladron-rodia.github.io,http://localhost:8000

# --- Email (Resend SMTP) ---
# Obtené la API key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email destino — donde te llegan los formularios
CONTACT_TO_EMAIL=hola@slowcraft.ai

# Email remitente — debe ser de un dominio verificado en Resend
# Formato: "Slowcraft <noreply@slowcraft.ai>"  o  "noreply@slowcraft.ai"
CONTACT_FROM_EMAIL=Slowcraft <noreply@slowcraft.ai>

# --- Admin (Fase 2) ---
# Single admin. Generá el hash con: npm run hash-password -- "tupassword"
# Estas dos vars solo se usan para BOOTSTRAP la primera vez (siembra DB si vacía).
# Después podés cambiar el password vía /admin/forgot.
ADMIN_EMAIL=tu-email@empresa.com
ADMIN_PASSWORD_HASH=$2a$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secreto para firmar JWTs. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiamenrandomYLargo
# URL pública del API (para construir links de reset password en emails)
APP_BASE_URL=https://slowcraft-api.onrender.com

# --- Server ---
PORT=8080
NODE_ENV=development
