{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "chore",
        "ci",
        "build",
        "revert"
      ]
    ],
    "scope-enum": [
      1,
      "always",
      [
        "template",
        "instance",
        "backend",
        "admin",
        "i18n",
        "plugins",
        "ds",
        "form",
        "seo",
        "ci",
        "deps",
        "docs",
        "repo"
      ]
    ],
    "subject-case": [2, "never", ["upper-case", "pascal-case", "start-case"]],
    "header-max-length": [2, "always", 100],
    "body-max-line-length": [1, "always", 120]
  }
}
